---
import { labels, dateLabel } from '../lib/content';
import type { Post } from '../lib/schema';
const { post } = Astro.props as { post: Post };
---

<article class="post-card">
  <a
    href={`/actualidad/${post.slug}/`}
    class="post-image"
    tabindex="-1"
    aria-hidden="true"
  >
    <img
      src={post.image || '/media/conversacion.svg'}
      alt=""
      width="640"
      height="440"
      loading="lazy"
    />
  </a>
  <div class="post-meta">
    <span>{labels[post.type]}</span>
    <time datetime={post.date}>{dateLabel(post.date)}</time>
  </div>
  <h3>
    <a href={`/actualidad/${post.slug}/`}>{post.title}</a>
  </h3>
  <p>{post.summary}</p>
  <a class="text-link" href={`/actualidad/${post.slug}/`}>
    Leer publicación <span aria-hidden="true">↗</span>
  </a>
</article>
