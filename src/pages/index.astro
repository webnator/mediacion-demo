---
import Layout from '../layouts/Layout.astro';
import Mark from '../components/Mark.astro';
import PostCard from '../components/PostCard.astro';
import {site,getPosts} from '../lib/content';
const posts=await getPosts();
---
<Layout>
<section class="hero wrap"><div class="hero-copy"><h1>{site.heroTitle}</h1><p>{site.heroText}</p><a class="button" href="#contacto">{site.heroCta}<span aria-hidden="true">↗</span></a></div><div class="hero-art" aria-label="Dos perspectivas que encuentran un espacio común" role="img"><div class="art-grid"><div class="half left"></div><div class="half right"></div><span class="art-center">un espacio<br/>en común</span></div><div class="art-caption"><span>Distintas miradas.</span><span>Nuevas posibilidades.</span></div></div><div class="hero-foot"><span>Mediación empresarial · Facilitación · Diálogo</span><a href={site.servicesVisible ? "#acompanamos" : "#contacto"}>Hay otra manera de avanzar <span aria-hidden="true">↓</span></a></div></section>
{site.servicesVisible && <section class="services wrap section" id="acompanamos"><div class="section-head"><h2>{site.servicesTitle}</h2><p>Las organizaciones son relaciones.<br/>Cuidarlas también es parte del trabajo.</p></div><div class="service-list">{site.services.map((s)=><article><h3>{s.title}</h3><p>{s.text}</p><span>{s.detail}</span></article>)}</div></section>}
{site.aboutVisible && <section class="about" id="nosotros"><div class="wrap about-grid"><div><Mark large/><p class="about-note">{site.aboutNote}</p></div><div><h2>{site.aboutTitle}</h2><p>{site.aboutText}</p><a class="text-link" href="#contacto">Conozcámonos <span aria-hidden="true">↗</span></a></div></div></section>}
{site.processVisible && <section class="process wrap section"><h2>{site.processTitle}</h2><ol>{site.steps.map((s)=><li><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol></section>}
{site.newsVisible && <section class="news wrap section"><div class="section-head"><h2>{site.newsTitle}</h2><a class="text-link" href="/actualidad/">Todas las publicaciones <span aria-hidden="true">↗</span></a></div><div class="post-grid">{posts.length?posts.slice(0,3).map(post=><PostCard post={post}/>):<p>Pronto compartiremos nuevas ideas. Vuelve a visitarnos.</p>}</div></section>}
<section class="contact" id="contacto"><div class="wrap contact-grid"><h2>{site.contactTitle}</h2><div><p>{site.contactText}</p>{site.contactEnabled?<a class="contact-email" href={`mailto:${site.email}`}>{site.email}<span aria-hidden="true">↗</span></a>:<><span class="contact-email">{site.email}</span><small>Contacto de ejemplo · No se envían mensajes.</small></>}<span class="location">{site.location}</span></div></div></section>
</Layout>
