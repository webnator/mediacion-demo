---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { site, getPosts } from '../../lib/content';
const posts = await getPosts();
---

<Layout title={`Actualidad — ${site.name}`}>
  <section class="wrap listing section">
    <a class="text-link" href="/">
      Volver a inicio
    </a>
    <h1>{site.newsTitle}</h1>
    <p class="intro">
      Reflexiones, conversaciones y lecturas para cuidar las relaciones en el
      trabajo.
    </p>
    <div class="filters" role="group" aria-label="Filtrar publicaciones">
      {[
        ['todos', 'Todo'],
        ['articulo', 'Artículos'],
        ['enlace', 'Enlaces'],
        ['video', 'Vídeos'],
        ['podcast', 'Podcasts'],
      ].map(([value, label]) => (
        <button data-filter={value} aria-pressed={value === 'todos'}>
          {label}
        </button>
      ))}
    </div>
    <div class="post-grid">
      {posts.map((post) => (
        <div data-type={post.type}>
          <PostCard post={post} />
        </div>
      ))}
    </div>
    <p id="empty" class="empty" hidden={posts.length > 0}>
      Todavía no hay publicaciones de este tipo.
    </p>
  </section>
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-type]');
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b === button)),
      );
      let visible = 0;
      cards.forEach((card) => {
        card.hidden =
          button.dataset.filter !== 'todos' &&
          card.dataset.type !== button.dataset.filter;
        if (!card.hidden) visible++;
      });
      document.querySelector<HTMLElement>('#empty')!.hidden = visible > 0;
    }),
  );
</script>
